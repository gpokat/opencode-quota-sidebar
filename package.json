{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-quota-sidebar",
  "version": "0.3.0",
  "description": "OpenCode V2 sidebar: month-to-date token/cost usage, OpenCode Go quota windows, and Zen credit balance.",
  "type": "module",
  "license": "MIT",
  "author": "gpokat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gpokat/opencode-quota-sidebar.git"
  },
  "homepage": "https://github.com/gpokat/opencode-quota-sidebar#readme",
  "bugs": {
    "url": "https://github.com/gpokat/opencode-quota-sidebar/issues"
  },
  "bin": {
    "opencode-quota-sidebar": "./bin/cli.mjs"
  },
  "exports": {
    "./tui": "./dist/tui.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "tui.tsx",
    "tsconfig.json",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "esbuild src/tui.tsx --bundle --packages=external --format=esm --platform=neutral --target=es2022 --jsx=automatic --jsx-import-source=@opentui/solid --outfile=dist/tui.js",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plugin",
    "tui",
    "sidebar",
    "quota",
    "usage",
    "tokens",
    "credits",
    "opencode-go",
    "opencode-zen"
  ],
  "devDependencies": {
    "@opencode/plugin": "2.0.11",
    "@opentui/core": "0.5.11",
    "@opentui/solid": "0.5.11",
    "@types/bun": "^1.4.2",
    "esbuild": "^0.28.2",
    "solid-js": "1.9.12",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.0",
    "@opentui/core": ">=0.5.10",
    "@opentui/solid": ">=0.5.10",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  }
}
